+	const size_t W = m_Width + 1;
+	const int Sum = m_vExistSum[(size_t)(Ty1 + 1) * W + (Tx1 + 1)] - m_vExistSum[(size_t)Ty0 * W + (Tx1 + 1)] -
+			m_vExistSum[(size_t)(Ty1 + 1) * W + Tx0] + m_vExistSum[(size_t)Ty0 * W + Tx0];
+	return Sum != 0;
