+
+bool CCollision::ms_FastPaths = false;
+
+void CCollision::InitFast()
+{
+	m_FastOk = false;
+	if(!m_pTiles || m_pFront || m_pTele || m_pSpeedup || m_pSwitch || m_pTune || m_pDoor)
+		return;
+	const int N = m_Width * m_Height;
+	m_vFastSolid.assign(N, 0);
+	for(int i = 0; i < N; i++)
+	{
+		int T = m_pTiles[i].m_Index;
+		// tiles that would make MoveRestrictions, hook rays or IsThrough behave differently
+		if(T == TILE_STOP || T == TILE_STOPS || T == TILE_STOPA || T == TILE_THROUGH_ALL || T == TILE_THROUGH_DIR || T == TILE_THROUGH || T == TILE_THROUGH_CUT)
+			return;
+		m_vFastSolid[i] = (T == TILE_SOLID || T == TILE_NOHOOK) ? 1 : 0;
+	}
+	m_vFastSum.assign((m_Width + 1) * (m_Height + 1), 0);
+	for(int y = 0; y < m_Height; y++)
+		for(int x = 0; x < m_Width; x++)
+			m_vFastSum[(y + 1) * (m_Width + 1) + x + 1] = m_vFastSolid[y * m_Width + x] + m_vFastSum[y * (m_Width + 1) + x + 1] +
+								     m_vFastSum[(y + 1) * (m_Width + 1) + x] - m_vFastSum[y * (m_Width + 1) + x];
+	m_FastOk = true;
+}
+
+bool CCollision::FastAnySolid(float x0, float y0, float x1, float y1) const
+{
+	// conservative: pixel coordinates are widened by 2 before taking tiles, the same clamp as GetTile
+	int tx0 = std::clamp((int)std::floor((x0 - 2.0f) / 32.0f), 0, m_Width - 1);
+	int ty0 = std::clamp((int)std::floor((y0 - 2.0f) / 32.0f), 0, m_Height - 1);
+	int tx1 = std::clamp((int)std::floor((x1 + 2.0f) / 32.0f), 0, m_Width - 1);
+	int ty1 = std::clamp((int)std::floor((y1 + 2.0f) / 32.0f), 0, m_Height - 1);
+	const int W = m_Width + 1;
+	int Sum = m_vFastSum[(ty1 + 1) * W + tx1 + 1] - m_vFastSum[ty0 * W + tx1 + 1] - m_vFastSum[(ty1 + 1) * W + tx0] + m_vFastSum[ty0 * W + tx0];
+	return Sum > 0;
+}
