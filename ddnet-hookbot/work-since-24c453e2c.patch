+// one of us falling frozen down a freeze shaft, the other standing beside it: brute force over the catcher's jump,
+// hook (tick, aim lead, aim offset), drag direction and release, where the diver comes to rest. SS_C / SS_D spawn
+// positions (px), SS_DV the diver's velocity, SS_DDIR its direction until frozen; SS_ALL prints every result
+TEST_F(SimMapBots, SteerSearch)
+{
+	Kill(2);
+	vec2 C(331 * 32 + 16, 85 * 32 - 15), D(336.5f * 32, 60 * 32), DV(0, 0);
+	if(getenv("SS_C"))
+		sscanf(getenv("SS_C"), "%f,%f", &C.x, &C.y);
+	if(getenv("SS_D"))
+		sscanf(getenv("SS_D"), "%f,%f", &D.x, &D.y);
+	if(getenv("SS_DV"))
+		sscanf(getenv("SS_DV"), "%f,%f", &DV.x, &DV.y);
+	const int DDir = getenv("SS_DDIR") ? atoi(getenv("SS_DDIR")) : 0;
+	const int HMax = getenv("SS_HMAX") ? atoi(getenv("SS_HMAX")) : 70;
+	Spawn(1, vec2(318 * 32 + 16, 85 * 32 - 15));
+	Spawn(0, C);
+	for(int i = 0; i < 20; i++)
+		Step(2);
+	Spawn(1, D);
+	Chr(1)->m_Core.m_Vel = DV;
+	CHookBotSim Base;
+	CHookBot::InitSim(Base, GameServer(), Chr(0), Chr(1));
+	const float h = CCharacterCore::PhysicalSize() / 2;
+	auto OnGround = [&](const CHookBotSim &S, vec2 P) { return S.m_pCollision->CheckPoint(P.x + h, P.y + h + 5) || S.m_pCollision->CheckPoint(P.x - h, P.y + h + 5); };
+	const int DiverId = Base.m_aTee[1].m_Core.m_Id;
+	auto DiverIn = [&](const CHookBotSim &S) {
+		CNetObj_PlayerInput I = {};
+		I.m_TargetX = 1;
+		if(S.m_aTee[1].m_FreezeTime == 0)
+			I.m_Direction = DDir;
+		return I;
+	};
+	long Tried = 0, Grabbed = 0, Good = 0;
+	std::vector<std::pair<float, std::string>> vRes;
+	for(int PreDir = -1; PreDir <= 1; PreDir++)
+		for(int Jump = -1; Jump <= 50; Jump += Jump < 0 ? 1 : 2)
+		{
+			// the catcher's prefix: PreDir, jump at Jump; states before each tick
+			std::vector<CHookBotSim> vPre;
+			std::vector<int> vPrev;
+			CHookBotSim S = Base;
+			int Prev = 0;
+			for(int t = 0; t <= HMax; t++)
+			{
+				vPre.push_back(S);
+				vPrev.push_back(Prev);
+				CNetObj_PlayerInput I = {};
+				I.m_TargetX = 1;
+				I.m_Direction = PreDir;
+				I.m_Jump = t == Jump;
+				Prev = 0;
+				S.Step(I, DiverIn(S));
+			}
+			for(int H = std::max(0, Jump); H <= HMax; H++)
+				for(int Lead : {0, 1, 2, 3, 4})
+					for(int Dy : {-24, -12, 0, 12, 24})
+					{
+						Tried++;
+						CHookBotSim T = vPre[H];
+						int PrevHook = vPrev[H];
+						const vec2 Aim0 = T.m_aTee[1].m_Core.m_Pos + T.m_aTee[1].m_Core.m_Vel * (float)Lead + vec2(0, Dy) - T.m_aTee[0].m_Core.m_Pos;
+						bool Got = false;
+						int k = 0;
+						for(; k < 12 && !Got; k++)
+						{
+							CNetObj_PlayerInput I = {};
+							I.m_TargetX = round_to_int(Aim0.x);
+							I.m_TargetY = round_to_int(Aim0.y);
+							I.m_Direction = PreDir;
+							I.m_Jump = H + k == Jump;
+							I.m_Hook = HookBotHookInput(true, PrevHook, T.m_aTee[0].m_Core.m_HookState);
+							PrevHook = I.m_Hook;
+							T.Step(I, DiverIn(T));
+							Got = T.m_aTee[0].m_Core.HookedPlayer() == DiverId;
+							if(T.m_aTee[0].m_Core.m_HookState == HOOK_RETRACTED || T.m_aTee[0].m_Core.m_HookState == HOOK_GRABBED)
+								break;
+						}
+						if(!Got)
+							continue;
+						Grabbed++;
+						for(int HoldDir = -1; HoldDir <= 1; HoldDir++)
+						{
+							CHookBotSim R = T;
+							int PH = PrevHook;
+							for(int Hold = 0; Hold <= 40; Hold++)
+							{
+								if(Hold % 2 == 0)
+								{
+									// let go now: both to rest
+									CHookBotSim E = R;
+									int Rest = 0;
+									bool Bad = false;
+									for(int t = 0; t < 300 && Rest < 3 && !Bad; t++)
+									{
+										CNetObj_PlayerInput I = {};
+										I.m_TargetX = 1;
+										E.Step(I, DiverIn(E));
+										Bad = E.m_aTee[0].m_Dead || E.m_aTee[1].m_Dead;
+										Rest = length(E.m_aTee[0].m_Core.m_Vel) < 0.6f && length(E.m_aTee[1].m_Core.m_Vel) < 0.6f && OnGround(E, E.m_aTee[0].m_Core.m_Pos) &&
+												       OnGround(E, E.m_aTee[1].m_Core.m_Pos) ?
+											       Rest + 1 :
+											       0;
+									}
+									const vec2 E0 = E.m_aTee[0].m_Core.m_Pos, E1 = E.m_aTee[1].m_Core.m_Pos;
+									if(!Bad && Rest >= 3 && !E.InFreeze(E1) && !E.InFreeze(E0))
+									{
+										Good++;
+										char aBuf[256];
+										str_format(aBuf, sizeof(aBuf), "pre %d jump %d hook %d lead %d dy %d | hold %d dir %d | rest %.1f %.1f / diver %.1f %.1f %s", PreDir, Jump, H, Lead, Dy, Hold, HoldDir,
+											E0.x / 32, E0.y / 32, E1.x / 32, E1.y / 32, E.m_aTee[1].m_FreezeTime ? "frz" : "free");
+										vRes.push_back({E1.y * 4 - E1.x, aBuf});
+									}
+								}
+								CNetObj_PlayerInput I = {};
+								const vec2 A = R.m_aTee[1].m_Core.m_Pos - R.m_aTee[0].m_Core.m_Pos;
+								I.m_TargetX = round_to_int(A.x);
+								I.m_TargetY = round_to_int(A.y);
+								I.m_Direction = HoldDir;
+								I.m_Hook = HookBotHookInput(true, PH, R.m_aTee[0].m_Core.m_HookState);
+								PH = I.m_Hook;
+								R.Step(I, DiverIn(R));
+								if(R.m_aTee[0].m_Core.HookedPlayer() != DiverId)
+									break;
+							}
+						}
+					}
+		}
+	std::sort(vRes.begin(), vRes.end(), [](auto &a, auto &b) { return a.first > b.first; });
+	printf("ss: %ld tried, %ld grabbed, %ld good\n", Tried, Grabbed, Good);
+	for(int i = 0; i < (int)vRes.size() && (i < 40 || getenv("SS_ALL")); i++)
+		printf("ss %s\n", vRes[i].second.c_str());
+}
