+	m_pOwnJob->m_Tile = Tile;
+	for(int k = std::max(0, m_aOwnIndex[0] - 2); k <= std::min(m_aOwnIndex[0] + m_SoloLead, Last); k++)
+		m_pOwnJob->m_vLine.push_back(m_vRoute[k]);
