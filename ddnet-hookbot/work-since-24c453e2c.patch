+void CGameClient::HookBotHotReload()
+{
+#if !defined(CONF_FAMILY_WINDOWS)
+	if(!g_Config.m_ClHookbotHotreload || time_get() < m_HookBotNextPluginCheck)
+		return;
+	m_HookBotNextPluginCheck = time_get() + time_freq() / 4;
+	char aPath[IO_MAX_PATH_LENGTH];
+	if(fs_executable_path(aPath, sizeof(aPath)) != 0 || fs_parent_dir(aPath) != 0)
+		return;
+	str_append(aPath, "/libhookbot-hot.so");
+	std::error_code Error;
+	const auto Time = std::filesystem::last_write_time(aPath, Error);
+	if(Error)
+		return;
+	const int64_t Stamp = Time.time_since_epoch().count();
+	// wait until the linker is done with it
+	if(Stamp == m_HookBotPluginStamp || std::filesystem::file_time_type::clock::now() - Time < std::chrono::milliseconds(500))
+		return;
+	m_HookBotPluginStamp = Stamp;
+	// dlopen caches by path: load a copy under a new name each time
+	char aCopy[IO_MAX_PATH_LENGTH];
+	str_format(aCopy, sizeof(aCopy), "%s.%d.loaded", aPath, m_HookBotPluginLoads + 1);
+	if(!std::filesystem::copy_file(aPath, aCopy, std::filesystem::copy_options::overwrite_existing, Error))
+		return;
+	void *pHandle = dlopen(aCopy, RTLD_NOW | RTLD_LOCAL);
+	std::filesystem::remove(aCopy, Error);
+	char aMsg[512];
+	FHookBotCreate pfnCreate = pHandle ? (FHookBotCreate)dlsym(pHandle, "HookBotCreate") : nullptr;
+	if(!pfnCreate)
+	{
+		str_format(aMsg, sizeof(aMsg), "hot reload failed: %s", dlerror());
+		log_error("hookbot", "%s", aMsg);
+		HookBotSay(aMsg);
+		return;
+	}
+	m_vHookBotPluginHandles.push_back(pHandle);
+	std::unique_ptr<IHookBot> pNew(pfnCreate());
+	if(pNew->Abi() != HOOKBOT_PLUGIN_ABI)
+	{
+		HookBotSay("hot reload refused: the plugin doesn't match this client (hookbot_plugin.h or gamecore.h changed?), rebuild the client");
+		return;
+	}
+	m_HookBotPluginLoads++;
+	m_pHookBot = std::move(pNew);
+	// replay the commands since the last stop, quietly
+	const auto vCommands = m_vHookBotCommands;
+	m_vHookBotCommands.clear();
+	m_HookBotMuted = true;
+	for(const auto &[ClientId, Message] : vCommands)
+		HookBotOnChat(ClientId, Message.c_str());
+	m_HookBotMuted = false;
+	m_vHookBotCommands = vCommands;
+	str_format(aMsg, sizeof(aMsg), "reloaded my brain (#%d)%s", m_HookBotPluginLoads, vCommands.empty() ? "" : ", picking up where we were");
+	log_info("hookbot", "%s", aMsg);
+	HookBotSay(aMsg);
+#endif
+}
