+// the team-move judge's reachability checks between pairs of points: RP_PAIRS="x0,y0,x1,y1;..." in tiles
+TEST_F(SimMapBots, ReachProbe)
+{
+	Kill(2);
+	Spawn(1, vec2(64, 64));
+	Spawn(0, vec2(96, 64));
+	CHookBotSim S;
+	CHookBot::InitSim(S, GameServer(), Chr(0), Chr(1));
+	const char *p = getenv("RP_PAIRS");
+	ASSERT_TRUE(p);
+	while(*p)
+	{
+		float x0, y0, x1, y1;
+		ASSERT_EQ(sscanf(p, "%f,%f,%f,%f", &x0, &y0, &x1, &y1), 4);
+		while(*p && *p != ';')
+			p++;
+		if(*p)
+			p++;
+		const vec2 A(x0 * 32, y0 * 32), B(x1 * 32, y1 * 32);
+		const int64_t T0 = time_get();
+		const bool Ab = CHookBotBrain::TestCanReach(S, A, B), Ba = CHookBotBrain::TestCanReach(S, B, A);
+		printf("rp %.1f %.1f -> %.1f %.1f: reach %d, back %d, rescue %d (%.0f us)\n", x0, y0, x1, y1, Ab, Ba, CHookBotBrain::TestCanRescue(S, A, B), (time_get() - T0) * 1e6 / time_freq() / 2);
+	}
+}
