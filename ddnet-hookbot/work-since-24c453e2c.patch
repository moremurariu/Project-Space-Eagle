+		Plan.m_vPath.empty() ? 0.0f : Plan.m_vPath.back().x / 32, Plan.m_vPath.empty() ? 0.0f : Plan.m_vPath.back().y / 32, Plan.m_Score);
+	if(getenv("SB_DUMP"))
