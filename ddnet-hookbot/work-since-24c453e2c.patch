+		m_OwnSoloTile = m_pOwnJob->m_Tile;
+		m_pOwnJob.reset();
+	}
+	if(Tile == m_OwnSoloTile || (m_pOwnJob && m_pOwnJob->m_Tile == Tile))
+		return;
