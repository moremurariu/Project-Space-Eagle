+		Probe.m_pCollision = const_cast<CCollision *>(pCollision);
+		for(int y = 0; y < m_H; y++)
+			for(int x = 0; x < m_W; x++)
+			{
+				const vec2 Ct(x * 32 + 16, y * 32 + 16);
+				const int Game = pCollision->GetCollisionAt(Ct.x, Ct.y), Front = pCollision->GetFrontCollisionAt(Ct.x, Ct.y);
