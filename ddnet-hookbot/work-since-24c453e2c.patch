+void CGameClient::PredictCloudInput()
+{
+	std::fill(std::begin(m_aCloudPredicted), std::end(m_aCloudPredicted), false);
+
+	const float Amount = g_Config.m_ClCloudInputAmount / 100.0f;
+	if(Amount <= 0.0f || !Predict() || Client()->State() != IClient::STATE_ONLINE || m_Snap.m_LocalClientId < 0)
+		return;
+
+	// only extend a prediction that reached the current predicted tick
+	const int BaseTick = Client()->PredGameTick(g_Config.m_ClDummy);
+	if(m_PredictedWorld.GameTick() != BaseTick)
+		return;
+
+	// the scratch copy keeps the extra ticks from touching the real predicted world (events, destroyed entities)
+	m_CloudWorld.CopyWorld(&m_PredictedWorld, false);
+	m_CloudWorld.m_WorldConfig.m_PredictEvents = false;
+
+	const int LocalId = m_Snap.m_LocalClientId;
+	const int DummyId = PredictDummy() ? m_aLocalIds[!g_Config.m_ClDummy] : -1;
+	if(!m_CloudWorld.GetCharacterById(LocalId))
+		return;
+
+	// the input the next tick would get if it were sampled right now
+	const int Conn = g_Config.m_ClDummy ^ m_IsDummySwapping;
+	CNetObj_PlayerInput LiveInput = m_Controls.m_aInputData[Conn];
+	if(LiveInput.m_PlayerFlags & PLAYERFLAG_PLAYING)
+	{
+		LiveInput.m_Direction = 0;
+		if(m_Controls.m_aInputDirectionLeft[Conn] && !m_Controls.m_aInputDirectionRight[Conn])
+			LiveInput.m_Direction = -1;
+		if(!m_Controls.m_aInputDirectionLeft[Conn] && m_Controls.m_aInputDirectionRight[Conn])
+			LiveInput.m_Direction = 1;
+		if(g_Config.m_ClSubTickAiming)
+		{
+			LiveInput.m_TargetX = (int)m_Controls.m_aMousePos[Conn].x;
+			LiveInput.m_TargetY = (int)m_Controls.m_aMousePos[Conn].y;
+			if(!LiveInput.m_TargetX && !LiveInput.m_TargetY)
+				LiveInput.m_TargetX = 1;
+		}
+	}
+	else if(const CNetObj_PlayerInput *pLastSent = (CNetObj_PlayerInput *)Client()->GetInput(BaseTick, m_IsDummySwapping))
+	{
+		LiveInput = *pLastSent; // chat or menu open: keep the input the server has
+	}
+
+	// others go one tick ahead, from the preinputs the server forwards
+	const bool Others = g_Config.m_ClCloudInputOthers && m_ReceivedPreInput;
+	const int FinalTick = BaseTick + (int)std::ceil(Amount);
+	auto IsLocalTee = [&](int ClientId) { return ClientId == LocalId || ClientId == DummyId; };
+
+	for(int Tick = BaseTick + 1; Tick <= FinalTick; Tick++)
+	{
+		// characters can die in the extra ticks, so look them up every tick
+		CCharacter *pLocalChar = m_CloudWorld.GetCharacterById(LocalId);
+		if(!pLocalChar)
+			break;
+		CCharacter *pDummyChar = DummyId >= 0 ? m_CloudWorld.GetCharacterById(DummyId) : nullptr;
+
+		// fetch the previous characters
+		for(int i = 0; i < MAX_CLIENTS; i++)
+			if(CCharacter *pChar = m_CloudWorld.GetCharacterById(i))
+				if((IsLocalTee(i) && Tick == FinalTick) || (!IsLocalTee(i) && Others && Tick == BaseTick + 1))
+					m_aClients[i].m_PrevPredicted = pChar->GetCore();
+		if(Tick == FinalTick)
+			m_PredictedPrevChar = pLocalChar->GetCore();
+
+		// apply inputs and tick, the dummy keeps its latest sent input
+		CNetObj_PlayerInput *pDummyInputData = !pDummyChar ? nullptr : (CNetObj_PlayerInput *)Client()->GetInput(Tick, m_IsDummySwapping ^ 1);
+		bool DummyFirst = pDummyInputData && pDummyChar->GetCid() < pLocalChar->GetCid();
+
+		if(DummyFirst)
+			pDummyChar->OnDirectInput(pDummyInputData);
+		pLocalChar->OnDirectInput(&LiveInput);
+		if(pDummyInputData && !DummyFirst)
+			pDummyChar->OnDirectInput(pDummyInputData);
+
+		ApplyPreInputs(Tick, true, m_CloudWorld);
+
+		m_CloudWorld.m_GameTick = Tick;
+		pLocalChar->OnPredictedInput(&LiveInput);
+		if(pDummyInputData)
+			pDummyChar->OnPredictedInput(pDummyInputData);
+
+		ApplyPreInputs(Tick, false, m_CloudWorld);
+
+		m_CloudWorld.Tick();
+
+		// fetch the current characters
+		for(int i = 0; i < MAX_CLIENTS; i++)
+		{
+			CCharacter *pChar = m_CloudWorld.GetCharacterById(i);
+			if(!pChar || !(IsLocalTee(i) || (Others && Tick == BaseTick + 1)))
+				continue;
+			m_aClients[i].m_aPredPos[Tick % 200] = pChar->Core()->m_Pos;
+			m_aClients[i].m_aPredTick[Tick % 200] = Tick;
+			if((IsLocalTee(i) && Tick == FinalTick) || !IsLocalTee(i))
+			{
+				m_aClients[i].m_Predicted = pChar->GetCore();
+				m_aCloudPredicted[i] = true;
+			}
+			if(i == LocalId && Tick == FinalTick)
+				m_PredictedChar = pChar->GetCore();
+		}
+	}
+}
+
+bool CGameClient::CloudInputPos(int ClientId, vec2 &Pos) const
+{
+	// the core is a whole number of ticks ahead, the position only by the configured fraction
+	const float Time = Client()->PredGameTick(g_Config.m_ClDummy) - 1 + Client()->PredIntraGameTick(g_Config.m_ClDummy) + g_Config.m_ClCloudInputAmount / 100.0f;
+	const int Tick = (int)Time + 1;
+	const float Intra = Time - (int)Time;
+	if(Tick <= 1 || m_aClients[ClientId].m_aPredTick[(Tick - 1) % 200] != Tick - 1 || m_aClients[ClientId].m_aPredTick[Tick % 200] != Tick)
+		return false;
+	Pos = mix(m_aClients[ClientId].m_aPredPos[(Tick - 1) % 200], m_aClients[ClientId].m_aPredPos[Tick % 200], Intra);
+	return true;
+}
