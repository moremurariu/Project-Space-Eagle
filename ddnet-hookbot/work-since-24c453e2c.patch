+											J.m_Core.m_Pos.x / 32, J.m_Core.m_Pos.y / 32, J.m_Core.m_Vel.x, J.m_Core.m_Vel.y, J.m_FreezeTime, H.m_Core.m_Pos.x / 32, H.m_Core.m_Pos.y / 32, H.m_Core.m_Vel.x, H.m_Core.m_Vel.y, H.m_FreezeTime);
+									break;
+								}
+								if(t % 8 == 0)
