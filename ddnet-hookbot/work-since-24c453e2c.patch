+		for(auto &E : C.m_vEntries)
+			if(E.m_pCollision == pCollision && E.m_Gx == gx && E.m_Gy == gy && E.m_FreezeCost == FreezeCost && (UseLine ? E.m_Radius == Radius && E.m_FarCost == FarCost && E.m_vLine == vLine : E.m_vLine.empty()))
