+// exploration: the catch after a throw: CS_TOP (px) stands above the freeze, CS_LOW (px) below; the low one walks to an
+// x, jumps (and air-jumps), the top one walks to an x, hooks it at some tick and holds a direction while pulling.
+// Counts plans that leave both at rest above y CS_LINE outside the freeze (the low one may be frozen: it thaws)
+TEST_F(SimMapBots, CatchSearch)
+{
+	Kill(2);
+	float ax = 165.0f * 32, ay = 27.5f * 32, bx = 167.0f * 32, by = 45.5f * 32;
+	if(getenv("CS_TOP"))
+		sscanf(getenv("CS_TOP"), "%f,%f", &ax, &ay);
+	if(getenv("CS_LOW"))
+		sscanf(getenv("CS_LOW"), "%f,%f", &bx, &by);
+	const float Line = getenv("CS_LINE") ? atof(getenv("CS_LINE")) : 896;
+	Spawn(1, vec2(bx, by));
+	Spawn(0, vec2(ax, ay));
+	for(int i = 0; i < 20; i++)
+		Step(2);
+	CHookBotSim Base;
+	CHookBot::InitSim(Base, GameServer(), Chr(0), Chr(1));
+	printf("cs start: top %.1f %.1f low %.1f %.1f\n", Base.m_aTee[0].m_Core.m_Pos.x, Base.m_aTee[0].m_Core.m_Pos.y, Base.m_aTee[1].m_Core.m_Pos.x, Base.m_aTee[1].m_Core.m_Pos.y);
+	const float h = CCharacterCore::PhysicalSize() / 2;
+	auto OnGround = [&](const CHookBotSim &S, vec2 P) { return S.m_pCollision->CheckPoint(P.x + h, P.y + h + 5) || S.m_pCollision->CheckPoint(P.x - h, P.y + h + 5); };
+	auto Steer = [](float Target, float X, float Vx) {
+		const float Err = Target - (X + Vx * 3);
+		return Err > 4 ? 1 : Err < -4 ? -1 : 0;
+	};
+	long Tried = 0, Good = 0;
+	std::vector<std::string> vRes;
+	const int aJumpL[] = {0, 8, 16, 24};
+	const int aAirL[] = {-1, 10, 16, 22};
+	const int aHookRel[] = {0, 4, 8, 12, 16, 20, 24, 28, 32, 36};
+	for(float XL = 4960; XL <= 5248; XL += 32)
+		for(int JumpL : aJumpL)
+			for(int AirL : aAirL)
+				for(float XT = 5216; XT <= 5296; XT += 16)
+					for(int HookRel : aHookRel)
+						for(float AimDy : {0.0f, -16.0f})
+							for(int DirT = -1; DirT <= 1; DirT++)
+							{
+								Tried++;
+								CHookBotSim S = Base;
+								const int HookAt = JumpL + HookRel;
+								int PrevHook = 0, RestT = -1, RestL = -1;
+								bool Bad = false;
+								for(int t = 0; t < 400 && !Bad && (RestT < 0 || RestL < 0); t++)
+								{
+									const auto &T = S.m_aTee[0], &L = S.m_aTee[1];
+									CNetObj_PlayerInput IT = {}, IL = {};
+									IT.m_TargetX = IL.m_TargetX = 1;
+									IL.m_Direction = Steer(XL, L.m_Core.m_Pos.x, L.m_Core.m_Vel.x);
+									IL.m_Jump = t == JumpL || (AirL >= 0 && t == JumpL + AirL);
+									const vec2 D = L.m_Core.m_Pos + vec2(0, AimDy) - T.m_Core.m_Pos;
+									IT.m_TargetX = round_to_int(D.x);
+									IT.m_TargetY = round_to_int(D.y);
+									const bool Want = t >= HookAt && L.m_Core.m_Pos.y > T.m_Core.m_Pos.y - 8;
+									IT.m_Hook = HookBotHookInput(Want, PrevHook, T.m_Core.m_HookState);
+									PrevHook = IT.m_Hook;
+									IT.m_Direction = t >= HookAt ? DirT : Steer(XT, T.m_Core.m_Pos.x, T.m_Core.m_Vel.x);
+									S.Step(IT, IL);
+									Bad = S.m_aTee[0].m_Dead || S.m_aTee[1].m_Dead || S.m_aTee[0].m_EnteredFreeze;
+									if(t > HookAt + 10 && RestT < 0 && length(S.m_aTee[0].m_Core.m_Vel) < 0.6f && OnGround(S, S.m_aTee[0].m_Core.m_Pos) && !IT.m_Hook)
+										RestT = t;
+									if(t > JumpL + 5 && RestL < 0 && length(S.m_aTee[1].m_Core.m_Vel) < 0.6f && OnGround(S, S.m_aTee[1].m_Core.m_Pos))
+										RestL = t;
+								}
+								if(Bad || RestT < 0 || RestL < 0)
+									continue;
+								const vec2 ET = S.m_aTee[0].m_Core.m_Pos, EL = S.m_aTee[1].m_Core.m_Pos;
+								if(ET.y > Line || EL.y > Line || S.InFreeze(ET) || S.InFreeze(EL))
+									continue;
+								Good++;
+								char aBuf[256];
+								str_format(aBuf, sizeof(aBuf), "low to %.0f jump %d air %d | top to %.0f hook +%d aim %.0f dir %d | top rests %.1f %.1f low %.1f %.1f at %d/%d", XL, JumpL, AirL, XT, HookRel, AimDy, DirT, ET.x / 32,
+									ET.y / 32, EL.x / 32, EL.y / 32, RestT, RestL);
+								vRes.push_back(aBuf);
+							}
+	printf("cs: %ld tried, %ld good\n", Tried, Good);
+	for(int i = 0; i < (int)vRes.size() && (i < 40 || getenv("CS_ALL")); i++)
+		printf("cs %s\n", vRes[i].c_str());
+}
+
+// exploration: both standing (LS_A, LS_B px), running in LS_DIR: the one in front hooks the one behind (or nobody),
+// lets go some ticks around the jump, each jumps near the end of the floor (or at a tick) and maybe air-jumps. Prints
+// the plans after which both come to rest outside the freeze beyond x LS_X (px), frozen ones included (they thaw)
+TEST_F(SimMapBots, LeapSearch)
+{
+	Kill(2);
+	float ax = 172.0f * 32, ay = 27.5f * 32, bx = 174.0f * 32, by = 27.5f * 32;
+	if(getenv("LS_A"))
+		sscanf(getenv("LS_A"), "%f,%f", &ax, &ay);
+	if(getenv("LS_B"))
+		sscanf(getenv("LS_B"), "%f,%f", &bx, &by);
+	const int Dir = getenv("LS_DIR") ? atoi(getenv("LS_DIR")) : 1;
+	const float MinX = getenv("LS_X") ? atof(getenv("LS_X")) : 202 * 32;
+	Spawn(1, vec2(bx, by));
+	Spawn(0, vec2(ax, ay));
+	for(int i = 0; i < 20; i++)
+		Step(2);
+	CHookBotSim Base;
+	CHookBot::InitSim(Base, GameServer(), Chr(0), Chr(1));
+	const float h = CCharacterCore::PhysicalSize() / 2;
+	auto OnGround = [&](const CHookBotSim &S, vec2 P) { return S.m_pCollision->CheckPoint(P.x + h, P.y + h + 5) || S.m_pCollision->CheckPoint(P.x - h, P.y + h + 5); };
+	const int Front = (Base.m_aTee[0].m_Core.m_Pos.x - Base.m_aTee[1].m_Core.m_Pos.x) * Dir > 0 ? 0 : 1, Back = 1 - Front;
+	long Tried = 0, Good = 0;
+	std::vector<std::string> vRes;
+	const int aAir[] = {-1, 6, 10, 14, 18, 22, 26, 30};
+	for(int HookMode = 0; HookMode <= 1; HookMode++)
+		for(int HookAt : {0, 4})
+			for(int RelRel : {-8, -4, 0, 4, 8, 16})
+				for(int EdgeB : {0, 3, 6})
+					for(int AirB : aAir)
+						for(int EdgeF : {0, 3, 6, 12})
+							for(int AirF : aAir)
+							{
+								if(!HookMode && (HookAt || RelRel))
+									continue;
+								Tried++;
+								CHookBotSim S = Base;
+								int PrevHook = S.m_aTee[Front].m_PrevInput.m_Hook;
+								int JumpB = -1, JumpF = -1, Rest = 0;
+								bool Bad = false;
+								for(int t = 0; t < 400 && !Bad && Rest < 2; t++)
+								{
+									CNetObj_PlayerInput aI[2] = {};
+									for(int i = 0; i < 2; i++)
+									{
+										const auto &T = S.m_aTee[i];
+										const int Edge = i == Back ? EdgeB : EdgeF;
+										int &Jump = i == Back ? JumpB : JumpF;
+										const int Air = i == Back ? AirB : AirF;
+										aI[i].m_Direction = Dir;
+										aI[i].m_TargetX = Dir;
+										// jump when the floor ends within Edge+1 ticks at this speed
+										if(Jump < 0 && OnGround(S, T.m_Core.m_Pos) && !OnGround(S, T.m_Core.m_Pos + vec2(T.m_Core.m_Vel.x * (Edge + 1) + Dir * 4, 0)))
+										{
+											aI[i].m_Jump = 1;
+											Jump = t;
+										}
+										if(Jump >= 0 && Air >= 0 && t == Jump + Air)
+											aI[i].m_Jump = 1;
+									}
+									if(HookMode)
+									{
+										const auto &F = S.m_aTee[Front], &B = S.m_aTee[Back];
+										const vec2 D = B.m_Core.m_Pos - F.m_Core.m_Pos;
+										aI[Front].m_TargetX = round_to_int(D.x);
+										aI[Front].m_TargetY = round_to_int(D.y);
+										const bool Want = t >= HookAt && (JumpB < 0 || t < JumpB + RelRel);
+										aI[Front].m_Hook = HookBotHookInput(Want, PrevHook, F.m_Core.m_HookState);
+										PrevHook = aI[Front].m_Hook;
+									}
+									S.Step(aI[0], aI[1]);
+									Bad = S.m_aTee[0].m_Dead || S.m_aTee[1].m_Dead;
+									Rest = t > 20 && JumpB >= 0 && JumpF >= 0 && length(S.m_aTee[0].m_Core.m_Vel) < 0.6f && length(S.m_aTee[1].m_Core.m_Vel) < 0.6f && OnGround(S, S.m_aTee[0].m_Core.m_Pos) &&
+										       OnGround(S, S.m_aTee[1].m_Core.m_Pos) ?
+										   Rest + 1 :
+										   0;
+								}
+								if(Bad || Rest < 2)
+									continue;
+								const vec2 E0 = S.m_aTee[0].m_Core.m_Pos, E1 = S.m_aTee[1].m_Core.m_Pos;
+								// LS_RELAX: one may lie in freeze if the other is outside it, within 8 tiles with a clear line (it
+								// pulls it out after thawing)
+								const bool F0 = S.InFreeze(E0), F1 = S.InFreeze(E1);
+								if(getenv("LS_RELAX") ? (F0 && F1) || ((F0 || F1) && (distance(E0, E1) > 8 * 32 || S.m_pCollision->IntersectLine(E0, E1, nullptr, nullptr))) : (F0 || F1))
+									continue;
+								if((E0.x - MinX) * Dir < 0 || (E1.x - MinX) * Dir < 0)
+									continue;
+								Good++;
+								char aBuf[256];
+								str_format(aBuf, sizeof(aBuf), "hook %d at %d rel %d | back edge %d air %d | front edge %d air %d | rest %.1f %.1f %s / %.1f %.1f %s", HookMode, HookAt, RelRel, EdgeB, AirB, EdgeF, AirF,
+									E0.x / 32, E0.y / 32, S.m_aTee[0].m_FreezeTime ? "frz" : "free", E1.x / 32, E1.y / 32, S.m_aTee[1].m_FreezeTime ? "frz" : "free");
+								vRes.push_back(aBuf);
+							}
+	printf("ls: %ld tried, %ld good\n", Tried, Good);
+	for(int i = 0; i < (int)vRes.size() && (i < 40 || getenv("LS_ALL")); i++)
+		printf("ls %s\n", vRes[i].c_str());
+}
+
+// the joint search (CHookBotBrain::PlanJoint) from a list of states, without playing anything: JB_STATES is
+// "x0,y0,f0,x1,y1,f1;..." (px, f: 1 = frozen, settled there first), JB_GOAL a goal tile "x,y", HH_JOINT the beam. Prints
+// whether it found a plan, its value, where both end and how many ticks it took
+TEST_F(SimMapBots, JointBench)
+{
+	Kill(2);
+	vec2 Goal(256, 59);
+	if(getenv("JB_GOAL"))
+		sscanf(getenv("JB_GOAL"), "%f,%f", &Goal.x, &Goal.y);
+	if(getenv("HH_JOINT"))
+		sscanf(getenv("HH_JOINT"), "%d,%d,%d,%d,%d", &CHookBotBrain::ms_Joint.m_Width, &CHookBotBrain::ms_Joint.m_K, &CHookBotBrain::ms_Joint.m_MaxDepth, &CHookBotBrain::ms_Joint.m_NumCoast,
+			&CHookBotBrain::ms_Joint.m_Passes);
+	const int Budget = getenv("HH_TEAMBUDGET") ? atoi(getenv("HH_TEAMBUDGET")) : 600000;
+	CHookBotBrain Brain;
+	Brain.Init(Col(), &GameServer()->m_pController->Teams().m_Core);
+	Brain.SetGoal(Goal);
+	// (the open-air field to another tile: live it goes to the first waypoint ahead reachable through air)
+	if(getenv("JB_AIRGOAL"))
+	{
+		vec2 Air;
+		sscanf(getenv("JB_AIRGOAL"), "%f,%f", &Air.x, &Air.y);
+		auto pAir = std::make_shared<CHookBotGoalField>();
+		pAir->Build(Col(), Air, 0);
+		Brain.m_pGoalAir = pAir;
+	}
+	const char *p = getenv("JB_STATES");
+	ASSERT_TRUE(p);
+	int Found = 0, Total = 0;
+	float SumValue = 0;
+	long SumSteps = 0;
+	while(*p)
+	{
+		float x0, y0, x1, y1;
+		int f0, f1;
+		vec2 V0(0, 0), V1(0, 0);
+		const int Got = sscanf(p, "%f,%f,%d,%f,%f,%d,%f,%f,%f,%f", &x0, &y0, &f0, &x1, &y1, &f1, &V0.x, &V0.y, &V1.x, &V1.y);
+		ASSERT_TRUE(Got == 6 || Got == 10);
+		while(*p && *p != ';')
+			p++;
+		if(*p)
+			p++;
+		Spawn(1, vec2(x1, y1));
+		Spawn(0, vec2(x0, y0));
+		if(f0)
+			Chr(0)->Freeze();
+		if(f1)
+			Chr(1)->Freeze();
+		// with velocities: flying, as given (else settled there first)
+		if(Got == 10)
+		{
+			Chr(0)->m_Core.m_Vel = V0;
+			Chr(1)->m_Core.m_Vel = V1;
+		}
+		else
+			for(int i = 0; i < 20; i++)
+				Step(2);
+		if(f0)
+			Chr(0)->Freeze();
+		if(f1)
+			Chr(1)->Freeze();
+		CHookBotSim Base;
+		CHookBot::InitSim(Base, GameServer(), Chr(0), Chr(1));
+		// (a live search's whole state, HH_SIMDUMP)
+		if(getenv("JB_SIM"))
+			ASSERT_TRUE(HookBotSimLoad(Base, getenv("JB_SIM")));
+		CHookBotBrain::ms_DebugTeam = true;
+		std::vector<vec2> vFinish;
+		for(int y = 0; y < Col()->GetHeight(); y++)
+			for(int x = 0; x < Col()->GetWidth(); x++)
+			{
+				const int Idx = y * Col()->GetWidth() + x;
+				if(Col()->GetTileIndex(Idx) == TILE_FINISH || Col()->GetFrontTileIndex(Idx) == TILE_FINISH)
+					vFinish.push_back(vec2(x * 32 + 16, y * 32 + 16));
+			}
+		const auto Plan = getenv("JB_FINISHDROP") ? CHookBotBrain::PlanFinishDrop(Base, vFinish, Budget) :
+				  getenv("JB_FLING") ? CHookBotBrain::PlanFling(Base, *Brain.m_pGoal, Budget) :
+				  getenv("JB_LAUNCH") ? CHookBotBrain::PlanLaunch(Base, *Brain.m_pGoal, *Brain.m_pGoalAir, Budget, Brain.m_Pseudo) :
+				  getenv("JB_COLUMN") ? CHookBotBrain::PlanColumnDrop(Base, *Brain.m_pGoal, Budget) :
+				  getenv("JB_DRAG") ? CHookBotBrain::PlanDrag(Base, *Brain.m_pGoal, Budget) :
+				  getenv("JB_REACH") ? CHookBotBrain::PlanReachHook(Base, *Brain.m_pGoal, Budget) :
+				  getenv("JB_CLIMB") ? CHookBotBrain::PlanClimb(Base, *Brain.m_pGoal, *Brain.m_pGoalAir, Budget, Brain.m_Pseudo, atoi(getenv("JB_CLIMB")) > 1 ? atoi(getenv("JB_CLIMB")) : 300) :
+				  getenv("JB_CATCH") ? CHookBotBrain::PlanCatch(Base, *Brain.m_pGoal, Budget) :
+				  getenv("JB_HOP") ? CHookBotBrain::PlanHop(Base, *Brain.m_pGoal, Budget, Brain.m_Pseudo) :
+				  getenv("JB_DASH") ? CHookBotBrain::PlanDash(Base, *Brain.m_pGoal, Budget) :
+				  getenv("JB_DROP") ? CHookBotBrain::PlanDrop(Base, *Brain.m_pGoal, Budget) :
+				  getenv("JB_FALL") ? CHookBotBrain::PlanFall(Base, *Brain.m_pGoal, Budget, Brain.m_Pseudo) :
+						      CHookBotBrain::PlanJoint(Base, *Brain.m_pGoal, Budget);
+		Total++;
+		SumSteps += Plan.m_Steps;
+		printf("jb %.1f %.1f %s / %.1f %.1f %s: ", Base.m_aTee[0].m_Core.m_Pos.x / 32, Base.m_aTee[0].m_Core.m_Pos.y / 32, Base.m_aTee[0].m_FreezeTime ? "frz" : "free",
+			Base.m_aTee[1].m_Core.m_Pos.x / 32, Base.m_aTee[1].m_Core.m_Pos.y / 32, Base.m_aTee[1].m_FreezeTime ? "frz" : "free");
+		if(Plan.m_Valid)
+		{
+			Found++;
+			SumValue += Plan.m_Score;
+			printf("value %.0f, ends %.1f %.1f / %.1f %.1f, %d ticks long, %d searched\n", Plan.m_Score, Plan.m_aEnd[0].x / 32, Plan.m_aEnd[0].y / 32, Plan.m_aEnd[1].x / 32, Plan.m_aEnd[1].y / 32,
+				(int)Plan.m_avIn[0].size(), Plan.m_Steps);
+			// JB_DUMP: the plan's inputs, tick by tick (dir jump hook fire per tee, and where each is)
+			if(getenv("JB_DUMP"))
+				for(int k = 0; k < (int)Plan.m_avIn[0].size(); k++)
+					printf("jbdump %3d | %+d %d %d %d %7.1f %7.1f | %+d %d %d %d %7.1f %7.1f\n", k, Plan.m_avIn[0][k].m_Direction, Plan.m_avIn[0][k].m_Jump, Plan.m_avIn[0][k].m_Hook, Plan.m_avIn[0][k].m_Fire,
+						Plan.m_avPath[0][k].x / 32, Plan.m_avPath[0][k].y / 32, Plan.m_avIn[1][k].m_Direction, Plan.m_avIn[1][k].m_Jump, Plan.m_avIn[1][k].m_Hook, Plan.m_avIn[1][k].m_Fire,
+						Plan.m_avPath[1][k].x / 32, Plan.m_avPath[1][k].y / 32);
+		}
+		else
+			printf("none (%d searched)\n", Plan.m_Steps);
+	}
+	printf("jb: %d of %d found, mean value %.0f, %ld ticks searched\n", Found, Total, Found ? SumValue / Found : 0.0f, SumSteps);
+}
+
+// the real game's hammer: tee 0 (HP_A) and tee 1 (HP_B) = "x,y,vx,vy,frozen" in px, tee 0 jumps on tick HP_JUMP and fires
+// on tick HP_FIRE aimed at HP_AIM ("dx,dy", default straight up); prints both for HP_TICKS ticks
+TEST_F(SimMapBots, HammerProbe)
+{
+	Kill(2);
+	float a[5] = {0}, b[5] = {0};
+	ASSERT_TRUE(getenv("HP_A") && sscanf(getenv("HP_A"), "%f,%f,%f,%f,%f", &a[0], &a[1], &a[2], &a[3], &a[4]) == 5);
+	ASSERT_TRUE(getenv("HP_B") && sscanf(getenv("HP_B"), "%f,%f,%f,%f,%f", &b[0], &b[1], &b[2], &b[3], &b[4]) == 5);
+	const int Jump = getenv("HP_JUMP") ? atoi(getenv("HP_JUMP")) : -1, Fire = getenv("HP_FIRE") ? atoi(getenv("HP_FIRE")) : 0;
+	vec2 AimDir(0, -1);
+	if(getenv("HP_AIM"))
+		sscanf(getenv("HP_AIM"), "%f,%f", &AimDir.x, &AimDir.y);
+	Spawn(1, vec2(b[0], b[1]));
+	Spawn(0, vec2(a[0], a[1]));
+	const float *ap[2] = {a, b};
+	for(int i = 0; i < 2; i++)
+	{
+		Chr(i)->m_Core.m_Pos = Chr(i)->m_PrevPos = Chr(i)->m_Pos = vec2(ap[i][0], ap[i][1]);
+		Chr(i)->m_Core.m_Vel = vec2(ap[i][2], ap[i][3]);
+		Chr(i)->m_ReloadTimer = 0;
+		if(ap[i][4] != 0)
+			Chr(i)->Freeze();
+	}
+	for(int t = 0; t < (getenv("HP_TICKS") ? atoi(getenv("HP_TICKS")) : 6); t++)
+	{
+		m_aTee[0].m_Input.m_Jump = t == Jump;
+		Aim(0, normalize(AimDir));
+		if(t == Fire)
+			PressFire(0);
+		else
+			ReleaseFire(0);
+		Step(2);
+		printf("hp %d | %.1f %.1f v %.1f %.1f frz %d | %.1f %.1f v %.1f %.1f frz %d\n", t, Chr(0)->m_Pos.x, Chr(0)->m_Pos.y, Chr(0)->m_Core.m_Vel.x, Chr(0)->m_Core.m_Vel.y, Chr(0)->m_FreezeTime,
+			Chr(1)->m_Pos.x, Chr(1)->m_Pos.y, Chr(1)->m_Core.m_Vel.x, Chr(1)->m_Core.m_Vel.y, Chr(1)->m_FreezeTime);
+	}
+}
+
+// the solo swing search alone from a state: SB_STATE="x,y,vx,vy" (px), SB_PARTNER="x,y" (px, standing; far away by
+// default), SB_GOAL="x,y" (tile), SB_MS (default 400, deterministic at HH_DET ns per tick, default 2000); prints the plan
+// found and, with SB_DUMP=1, its path every 5 ticks (HH_SWINGDBG=1: the search's levels)
+// the finish search alone (FB_STATE="x,y" px, standing there; FB_PARTNER="x,y"; FB_MAX ticks): FinishMove's ways to a
+// finish tile by myself, 1-3 stages
+TEST_F(SimMapBots, FinishBench)
+{
+	Kill(2);
+	vec2 Pos(0, 0), Partner(64, 64);
+	ASSERT_TRUE(getenv("FB_STATE"));
+	sscanf(getenv("FB_STATE"), "%f,%f", &Pos.x, &Pos.y);
+	if(getenv("FB_PARTNER"))
+		sscanf(getenv("FB_PARTNER"), "%f,%f", &Partner.x, &Partner.y);
+	Spawn(1, Partner);
+	Spawn(0, Pos);
+	for(int i = 0; i < 20; i++)
+		Step(2);
+	CHookBotSim S;
+	CHookBot::InitSim(S, GameServer(), Chr(0), Chr(1));
+	std::vector<vec2> vFinish;
+	for(int y = 0; y < Col()->GetHeight(); y++)
+		for(int x = 0; x < Col()->GetWidth(); x++)
+		{
+			const int Idx = y * Col()->GetWidth() + x;
+			if(Col()->GetTileIndex(Idx) == TILE_FINISH || Col()->GetFrontTileIndex(Idx) == TILE_FINISH)
+				vFinish.push_back(vec2(x * 32 + 16, y * 32 + 16));
+		}
+	std::vector<vec2> vPath;
+	int Stages = 0, Steps = 0;
+	const bool Found = CHookBotBrain::TestFinishSearch(S, vFinish, getenv("FB_MAX") ? atoi(getenv("FB_MAX")) : 5000000, &vPath, &Stages, &Steps);
+	printf("fb from %.1f %.1f: %s, %d stages, %d ticks searched\n", S.m_aTee[0].m_Core.m_Pos.x / 32, S.m_aTee[0].m_Core.m_Pos.y / 32, Found ? "found" : "none", Stages, Steps);
+	for(size_t k = 0; k < vPath.size(); k += 5)
+		printf("fb path %3d: %.1f %.1f\n", (int)k, vPath[k].x / 32, vPath[k].y / 32);
+}
