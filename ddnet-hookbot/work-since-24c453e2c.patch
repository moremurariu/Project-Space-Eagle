+// two tees falling with no input from given states (DP_A / DP_B = "x,y,vx,vy,frozen" in tiles and px per tick):
+// where each comes to rest, in the brain's sim (DP_TICKS, default 300; DP_EVERY prints the path)
+TEST_F(SimMapBots, DropProbe)
+{
+	Kill(2);
+	float a[5] = {0}, b[5] = {0};
+	ASSERT_TRUE(getenv("DP_A") && sscanf(getenv("DP_A"), "%f,%f,%f,%f,%f", &a[0], &a[1], &a[2], &a[3], &a[4]) == 5);
+	ASSERT_TRUE(getenv("DP_B") && sscanf(getenv("DP_B"), "%f,%f,%f,%f,%f", &b[0], &b[1], &b[2], &b[3], &b[4]) == 5);
+	Spawn(1, vec2(b[0] * 32, b[1] * 32));
+	Spawn(0, vec2(a[0] * 32, a[1] * 32));
+	CHookBotSim S;
+	CHookBot::InitSim(S, GameServer(), Chr(0), Chr(1));
+	const float *ap[2] = {a, b};
+	for(int i = 0; i < 2; i++)
+	{
+		S.m_aTee[i].m_Core.m_Pos = S.m_aTee[i].m_PrevPos = vec2(ap[i][0] * 32, ap[i][1] * 32);
+		S.m_aTee[i].m_Core.m_Vel = vec2(ap[i][2], ap[i][3]);
+		if(ap[i][4] != 0)
+			S.m_aTee[i].m_FreezeTime = 150;
+	}
+	const int Ticks = getenv("DP_TICKS") ? atoi(getenv("DP_TICKS")) : 300;
+	const int Every = getenv("DP_EVERY") ? atoi(getenv("DP_EVERY")) : 0;
+	CNetObj_PlayerInput None = {};
+	None.m_TargetX = 1;
+	for(int t = 0; t < Ticks; t++)
+	{
+		if(Every && t % Every == 0)
+			printf("dp %3d | %.2f %.2f v %.1f %.1f frz %d | %.2f %.2f v %.1f %.1f frz %d\n", t, S.m_aTee[0].m_Core.m_Pos.x / 32, S.m_aTee[0].m_Core.m_Pos.y / 32, S.m_aTee[0].m_Core.m_Vel.x,
+				S.m_aTee[0].m_Core.m_Vel.y, S.m_aTee[0].m_FreezeTime, S.m_aTee[1].m_Core.m_Pos.x / 32, S.m_aTee[1].m_Core.m_Pos.y / 32, S.m_aTee[1].m_Core.m_Vel.x, S.m_aTee[1].m_Core.m_Vel.y,
+				S.m_aTee[1].m_FreezeTime);
+		S.Step(None, None);
+	}
+	for(int i = 0; i < 2; i++)
+		printf("dp tee %d rests at %.2f %.2f, %s, freeze %d\n", i, S.m_aTee[i].m_Core.m_Pos.x / 32, S.m_aTee[i].m_Core.m_Pos.y / 32, S.InFreeze(S.m_aTee[i].m_Core.m_Pos) ? "in freeze" : "outside freeze",
+			S.m_aTee[i].m_FreezeTime);
+}
