+static std::atomic<int> gs_NumHookBotProf{0};
+static int HookBotProfIndex(const char *pName)
+{
+	const int i = gs_NumHookBotProf++;
+	gs_aHookBotProf[i].m_pName = pName;
+	return i;
+}
+class CHookBotProfScope
