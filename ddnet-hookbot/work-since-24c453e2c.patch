+			printf("sb path %3d: %.1f %.1f dir %d hook %d jump %d\n", (int)k, Plan.m_vPath[k].x / 32, Plan.m_vPath[k].y / 32, Plan.m_vInputs[k].m_Direction, Plan.m_vInputs[k].m_Hook, Plan.m_vInputs[k].m_Jump);
